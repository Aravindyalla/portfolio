---
// Education.astro
import { portfolioData } from '../data/portfolio';

const { education, certifications } = portfolioData;
---

<section class="education-section" id="education">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <div class="section-tag">
        <span class="dot"></span>
        <span>Foundations & Credentials</span>
      </div>
      <h2 class="section-title">
        Education & <span class="text-gradient">Certifications</span>
      </h2>
      <p class="section-subtitle">
        Foundational degree in Computer Science & Data Science, complemented by verified industry certifications.
      </p>
    </div>

    <!-- Education & Certifications Layout -->
    <div class="education-layout">
      <!-- Degree Card -->
      {education.map((edu) => (
        <div class="education-card glass-card">
          <div class="edu-top-row">
            <div class="edu-icon-badge">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
            </div>

            <div class="edu-title-group">
              <h3 class="edu-degree">{edu.degree}</h3>
              <p class="edu-inst">
                <span>{edu.institution}</span> &bull; <span class="edu-loc">{edu.location}</span>
              </p>
            </div>

            <div class="edu-meta-badges">
              <span class="edu-badge">{edu.period}</span>
              <span class="edu-grade-badge">{edu.grade}</span>
            </div>
          </div>

          <p class="edu-desc">{edu.description}</p>

          <!-- Relevant Coursework -->
          <div class="edu-coursework-section">
            <h4 class="coursework-heading">RELEVANT TECHNICAL COURSEWORK:</h4>
            <div class="coursework-chips">
              {edu.coursework.map((course) => (
                <span class="tech-badge highlight">{course}</span>
              ))}
            </div>
          </div>

          <!-- Academic Highlights -->
          <div class="edu-highlights-section">
            <h4 class="highlights-heading">ACADEMIC HIGHLIGHTS:</h4>
            <ul class="edu-highlights-list">
              {edu.highlights.map((item) => (
                <li class="edu-hl-item">
                  <span class="check-mark">&bull;</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}

      <!-- Certifications Grid -->
      <div class="certifications-block">
        <h3 class="cert-heading">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky">
            <path d="M12 15l-2 5l9-9l-9-9l2 5l-7 4z"></path>
          </svg>
          Industry Certifications
        </h3>

        <div class="certs-grid">
          {certifications.map((cert) => (
            <div class="cert-card glass-card">
              <div class="cert-icon-wrap">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="7"></circle>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                </svg>
              </div>
              <div class="cert-info">
                <h4 class="cert-title">{cert.title}</h4>
                <span class="cert-issuer">{cert.issuer}</span>
              </div>
              <span class="cert-tag">{cert.badge}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .education-section {
    position: relative;
  }

  .education-layout {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 980px;
    margin: 0 auto;
  }

  .education-card {
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: rgba(12, 16, 24, 0.85);
  }

  .edu-top-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .edu-icon-badge {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(168, 85, 247, 0.1);
    border: 1px solid rgba(168, 85, 247, 0.3);
    color: var(--violet);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .edu-title-group {
    flex: 1;
    min-width: 260px;
  }
  .edu-degree {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .edu-inst {
    font-size: 0.92rem;
    color: var(--text-secondary);
  }
  .edu-loc {
    color: var(--sky);
    font-family: var(--font-mono);
  }
  .edu-meta-badges {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .edu-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: var(--sky);
  }
  .edu-grade-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
    font-weight: 600;
  }

  .edu-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .edu-coursework-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .coursework-heading {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .coursework-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .edu-highlights-section {
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }
  .highlights-heading {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }
  .edu-highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .edu-hl-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .check-mark {
    color: var(--violet);
    font-size: 1.2rem;
    line-height: 1;
  }

  /* Certifications Block */
  .certifications-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cert-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .cert-card {
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(12, 16, 24, 0.75);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }
  .cert-card:hover {
    border-color: rgba(56, 189, 248, 0.35);
    transform: translateY(-2px);
  }
  .cert-icon-wrap {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: var(--sky);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cert-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cert-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .cert-issuer {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }
  .cert-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  @media (max-width: 768px) {
    .education-card {
      padding: 20px;
    }
    .certs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
