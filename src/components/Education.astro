---
// Education.astro
import { portfolioData } from '../data/portfolio';

const { education, certifications } = portfolioData;
---

<section class="education-section" id="education">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <div class="section-tag">
        <span class="dot"></span>
        <span>Academic Background</span>
      </div>
      <h2 class="section-title">
        Education & <span class="text-gradient">Credentials</span>
      </h2>
      <p class="section-subtitle">
        Foundational technical degree in Data Science and verified certifications.
      </p>
    </div>

    <!-- Education & Certifications Layout -->
    <div class="education-layout">
      <!-- Clean Professional Education Card -->
      {education.map((edu) => (
        <div class="education-card glass-card">
          <div class="edu-card-header">
            <div class="edu-icon-badge">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
            </div>

            <div class="edu-title-group">
              <h3 class="edu-degree">{edu.displayTitle}</h3>
              <p class="edu-inst">{edu.institution}</p>
              <p class="edu-location">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {edu.location}
              </p>
            </div>

            <div class="edu-meta-badges">
              <span class="edu-period-badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                {edu.period}
              </span>
              <span class="edu-grade-badge">CGPA: 7.5 / 10</span>
            </div>
          </div>

          <p class="edu-desc">{edu.description}</p>

          <!-- Affiliated University Strip -->
          <div class="edu-affiliation-box">
            <span class="affiliation-label">AFFILIATED TO:</span>
            <span class="affiliation-value">{edu.affiliatedUniversity}</span>
          </div>
        </div>
      ))}

      <!-- Certifications -->
      <div class="certifications-block">
        <h3 class="cert-heading">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-sky">
            <circle cx="12" cy="8" r="7"></circle>
            <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
          </svg>
          Certifications
        </h3>

        <div class="certs-grid">
          {certifications.map((cert) => (
            <div class="cert-card glass-card">
              <div class="cert-icon-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="cert-info">
                <h4 class="cert-title">{cert.title}</h4>
                <span class="cert-issuer">{cert.issuer}</span>
              </div>
              <span class="cert-tag">{cert.badge}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .education-section {
    position: relative;
  }

  .education-layout {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 920px;
    margin: 0 auto;
  }

  .education-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: rgba(12, 16, 24, 0.85);
  }

  .edu-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .edu-icon-badge {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.3);
    color: var(--violet);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .edu-title-group {
    flex: 1;
    min-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .edu-degree {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .edu-inst {
    font-size: 0.95rem;
    font-weight: 600;
    color: #e2e8f0;
  }
  .edu-location {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.82rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .edu-meta-badges {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .edu-period-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: var(--sky);
    font-weight: 500;
  }
  .edu-grade-badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
    font-weight: 700;
  }

  .edu-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Affiliation Box */
  .edu-affiliation-box {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .affiliation-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }
  .affiliation-value {
    font-size: 0.9rem;
    font-weight: 600;
    color: #38bdf8;
  }

  /* Certifications Block */
  .certifications-block {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 6px;
  }
  .cert-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .certs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .cert-card {
    padding: 16px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(12, 16, 24, 0.75);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }
  .cert-card:hover {
    border-color: rgba(56, 189, 248, 0.35);
    transform: translateY(-2px);
  }
  .cert-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: var(--sky);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .cert-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .cert-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }
  .cert-issuer {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }
  .cert-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 2px 7px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .education-card {
      padding: 20px;
    }
    .certs-grid {
      grid-template-columns: 1fr;
    }
    .edu-card-header {
      flex-direction: column;
    }
  }
</style>
