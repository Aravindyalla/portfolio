---
// AravindAI.astro - Professional AI Portfolio Assistant ("Aravind AI")
---

<div id="aravind-ai-widget" class="ai-widget-wrapper">
  <!-- 1. Floating Launch Button -->
  <button
    id="ai-launch-btn"
    class="ai-floating-btn"
    type="button"
    aria-label="Open Aravind AI Chatbot"
    aria-expanded="false"
    aria-controls="ai-chat-window"
  >
    <div class="ai-btn-glow" aria-hidden="true"></div>
    <div class="ai-btn-icon-wrap">
      <!-- Neural / Sparkle AI Icon -->
      <svg class="ai-icon-sparkle" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"></path>
      </svg>
      <span class="ai-btn-pulse-dot" aria-hidden="true"></span>
    </div>
    <span class="ai-btn-label">Ask Aravind AI</span>
  </button>

  <!-- 2. Chat Window Container -->
  <div
    id="ai-chat-window"
    class="ai-chat-card"
    role="dialog"
    aria-labelledby="ai-chat-title"
    aria-describedby="ai-chat-subtitle"
    style="display: none;"
  >
    <!-- Chat Header -->
    <header class="ai-chat-header">
      <div class="ai-header-info">
        <div class="ai-avatar-badge" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a8 8 0 0 0-8 8c0 3.3 2 6.2 5 7.4V20a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2v-2.6c3-1.2 5-4.1 5-7.4a8 8 0 0 0-8-8z"></path>
            <line x1="9" y1="10" x2="9.01" y2="10"></line>
            <line x1="15" y1="10" x2="15.01" y2="10"></line>
          </svg>
          <span class="ai-status-online" title="Online"></span>
        </div>
        <div>
          <h2 id="ai-chat-title" class="ai-header-name">Aravind AI</h2>
          <p id="ai-chat-subtitle" class="ai-header-role">Ask me anything about Aravind</p>
        </div>
      </div>

      <div class="ai-header-actions">
        <!-- Clear Chat Button -->
        <button
          id="ai-clear-btn"
          class="ai-header-btn"
          type="button"
          title="Clear Conversation"
          aria-label="Clear Chat History"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
        </button>

        <!-- Close Chat Button -->
        <button
          id="ai-close-btn"
          class="ai-header-btn"
          type="button"
          title="Close Chat"
          aria-label="Close Chat"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- Chat Messages Scroll Area -->
    <div id="ai-messages-list" class="ai-messages-stream" role="log" aria-live="polite">
      <!-- Welcome Message -->
      <div class="ai-message-row ai-row-assistant">
        <div class="ai-bubble-avatar">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
        <div class="ai-bubble ai-bubble-assistant">
          <p>Hi! I'm <strong>Aravind AI</strong>, your interactive portfolio assistant. I can answer questions about Aravind's work at People Media Factory, his Enterprise RAG chatbot, skills, projects, and contact info.</p>
          <p class="ai-bubble-footnote">Pick a starter question below or type your own question!</p>
        </div>
      </div>
    </div>

    <!-- Starter Quick Questions Chips -->
    <div id="ai-starter-chips" class="ai-starter-chips">
      <span class="ai-chips-label">Suggested:</span>
      <div class="ai-chips-scroll">
        <button type="button" class="ai-chip-btn" data-query="What does Aravind do?">
          What does Aravind do?
        </button>
        <button type="button" class="ai-chip-btn" data-query="What are his main AI skills?">
          What are his main AI skills?
        </button>
        <button type="button" class="ai-chip-btn" data-query="Tell me about his RAG project.">
          Tell me about his RAG project
        </button>
        <button type="button" class="ai-chip-btn" data-query="How can I contact him?">
          How can I contact him?
        </button>
        <button type="button" class="ai-chip-btn" data-query="What technologies is he currently learning?">
          What is he learning?
        </button>
        <button type="button" class="ai-chip-btn" data-query="Show me Aravind's resume">
          Download Resume
        </button>
      </div>
    </div>

    <!-- Typing Indicator (Hidden by default) -->
    <div id="ai-typing-indicator" class="ai-typing-wrap" style="display: none;" aria-hidden="true">
      <div class="ai-typing-avatar">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
        </svg>
      </div>
      <div class="ai-typing-dots">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <span class="ai-typing-label">Aravind AI is thinking...</span>
    </div>

    <!-- Chat Input Area -->
    <form id="ai-input-form" class="ai-input-bar">
      <textarea
        id="ai-user-input"
        class="ai-textarea"
        rows="1"
        placeholder="Ask about Aravind's experience, RAG, skills..."
        aria-label="Ask Aravind AI a question"
        maxlength="500"
      ></textarea>
      <button
        id="ai-send-btn"
        class="ai-send-btn"
        type="submit"
        aria-label="Send Message"
        disabled
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
    <div class="ai-input-footer">
      <span>Press Enter to send &bull; Shift+Enter for new line</span>
    </div>
  </div>
</div>

<script>
  import { getOfflineAnswer } from '../data/aiKnowledge';

  document.addEventListener('DOMContentLoaded', () => {
    const launchBtn = document.getElementById('ai-launch-btn') as HTMLButtonElement | null;
    const chatWindow = document.getElementById('ai-chat-window') as HTMLElement | null;
    const closeBtn = document.getElementById('ai-close-btn') as HTMLButtonElement | null;
    const clearBtn = document.getElementById('ai-clear-btn') as HTMLButtonElement | null;
    const messagesList = document.getElementById('ai-messages-list') as HTMLElement | null;
    const typingIndicator = document.getElementById('ai-typing-indicator') as HTMLElement | null;
    const inputForm = document.getElementById('ai-input-form') as HTMLFormElement | null;
    const userInput = document.getElementById('ai-user-input') as HTMLTextAreaElement | null;
    const sendBtn = document.getElementById('ai-send-btn') as HTMLButtonElement | null;
    const starterChips = document.getElementById('ai-starter-chips') as HTMLElement | null;

    if (!launchBtn || !chatWindow || !inputForm || !userInput || !sendBtn || !messagesList) {
      return;
    }

    let isOpen = false;
    let isThinking = false;

    // Toggle Chat Window
    function toggleChat(open?: boolean) {
      isOpen = typeof open === 'boolean' ? open : !isOpen;
      chatWindow.style.display = isOpen ? 'flex' : 'none';
      launchBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

      if (isOpen) {
        userInput.focus();
        scrollToBottom();
      }
    }

    launchBtn.addEventListener('click', () => toggleChat());
    closeBtn?.addEventListener('click', () => toggleChat(false));

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        toggleChat(false);
      }
    });

    // Auto-scroll messages container
    function scrollToBottom() {
      if (messagesList) {
        messagesList.scrollTop = messagesList.scrollHeight;
      }
    }

    // Auto-expand textarea
    userInput.addEventListener('input', () => {
      userInput.style.height = 'auto';
      userInput.style.height = `${Math.min(userInput.scrollHeight, 120)}px`;
      sendBtn.disabled = userInput.value.trim().length === 0 || isThinking;
    });

    // Keyboard Send (Enter = Send, Shift+Enter = newline)
    userInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        if (!sendBtn.disabled && !isThinking) {
          submitQuestion(userInput.value.trim());
        }
      }
    });

    // Starter question chips
    starterChips?.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('[data-query]') as HTMLElement | null;
      if (!target) return;
      const query = target.getAttribute('data-query');
      if (query && !isThinking) {
        submitQuestion(query);
      }
    });

    // Clear Chat
    clearBtn?.addEventListener('click', () => {
      messagesList.innerHTML = `
        <div class="ai-message-row ai-row-assistant">
          <div class="ai-bubble-avatar">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div class="ai-bubble ai-bubble-assistant">
            <p>Chat cleared! What would you like to know about Aravind Naidu Yalla?</p>
          </div>
        </div>
      `;
      if (starterChips) starterChips.style.display = 'flex';
      scrollToBottom();
    });

    // Append Message to UI
    function appendMessage(role: 'user' | 'assistant', text: string, action?: any) {
      const row = document.createElement('div');
      row.className = `ai-message-row ${role === 'user' ? 'ai-row-user' : 'ai-row-assistant'}`;

      if (role === 'assistant') {
        const avatar = document.createElement('div');
        avatar.className = 'ai-bubble-avatar';
        avatar.innerHTML = `
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        `;
        row.appendChild(avatar);
      }

      const bubble = document.createElement('div');
      bubble.className = `ai-bubble ${role === 'user' ? 'ai-bubble-user' : 'ai-bubble-assistant'}`;

      // Convert line breaks and simple markdown
      const formattedText = formatAnswer(text);
      bubble.innerHTML = formattedText;

      // Append action button if present (Resume, LinkedIn, GitHub, Email/Contact)
      if (action && (action.url || action.label)) {
        const actionWrap = document.createElement('div');
        actionWrap.className = 'ai-action-btn-wrap';

        const isContactOrEmail =
          action.type === 'email' ||
          action.type === 'contact' ||
          (action.url && action.url.startsWith('mailto:')) ||
          (action.url && action.url.startsWith('#contact'));

        if (isContactOrEmail) {
          // 1. Copy Email button (click to copy email)
          const copyBtn = document.createElement('button');
          copyBtn.type = 'button';
          copyBtn.className = 'ai-action-pill ai-action-copy';
          copyBtn.innerHTML = `
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span>Copy Email (aravindyallao@gmail.com)</span>
          `;
          copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText('aravindyallao@gmail.com').then(() => {
              if ((window as any).showToast) {
                (window as any).showToast('Email copied: aravindyallao@gmail.com');
              }
              const label = copyBtn.querySelector('span');
              if (label) {
                const prev = label.textContent;
                label.textContent = 'Copied to clipboard!';
                setTimeout(() => { label.textContent = prev; }, 2000);
              }
            });
          });
          actionWrap.appendChild(copyBtn);

          // 2. Scroll to Contact Form on page
          const contactBtn = document.createElement('a');
          contactBtn.href = '#contact';
          contactBtn.className = 'ai-action-pill ai-action-contact';
          contactBtn.innerHTML = `
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            <span>Go to Contact Form</span> &darr;
          `;
          contactBtn.addEventListener('click', (e) => {
            e.preventDefault();
            toggleChat(false);
            const contactSection = document.getElementById('contact');
            if (contactSection) {
              contactSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
              setTimeout(() => {
                const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
                nameInput?.focus();
              }, 450);
            }
          });
          actionWrap.appendChild(contactBtn);
        } else {
          // Standard Actions: Resume, LinkedIn, GitHub, Anchors
          const actionBtn = document.createElement('a');
          actionBtn.href = action.url;
          actionBtn.className = 'ai-action-pill';
          const isAnchor = action.url && action.url.startsWith('#');
          actionBtn.target = isAnchor ? '_self' : '_blank';
          actionBtn.rel = 'noopener noreferrer';

          if (isAnchor) {
            actionBtn.addEventListener('click', (e) => {
              e.preventDefault();
              toggleChat(false);
              const target = document.querySelector(action.url);
              target?.scrollIntoView({ behavior: 'smooth' });
            });
          }

          let iconSvg = '';
          if (action.type === 'resume') {
            actionBtn.setAttribute('download', 'Aravind_Naidu_Yalla_Resume.pdf');
            iconSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>`;
          } else if (action.type === 'linkedin') {
            iconSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>`;
          } else if (action.type === 'github') {
            iconSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>`;
          } else {
            iconSvg = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>`;
          }

          actionBtn.innerHTML = `${iconSvg} <span>${action.label}</span> &rarr;`;
          actionWrap.appendChild(actionBtn);
        }

        bubble.appendChild(actionWrap);
      }

      row.appendChild(bubble);
      messagesList.appendChild(row);
      scrollToBottom();
    }

    function formatAnswer(str: string): string {
      // Escape HTML
      let clean = str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Bold markdown: **text**
      clean = clean.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

      // Convert bullet points and lines
      const lines = clean.split('\n');
      const formattedLines = lines.map((l) => {
        const trimmed = l.trim();
        if (trimmed.startsWith('•') || trimmed.startsWith('-') || trimmed.startsWith('*')) {
          return `<div class="ai-bullet">${trimmed}</div>`;
        }
        if (trimmed === '') {
          return '<div class="ai-spacer"></div>';
        }
        return `<p>${trimmed}</p>`;
      });

      return formattedLines.join('');
    }

    // Submit question flow
    async function submitQuestion(question: string) {
      if (!question || isThinking) return;

      appendMessage('user', question);
      userInput.value = '';
      userInput.style.height = 'auto';
      sendBtn.disabled = true;

      // Show typing indicator
      isThinking = true;
      if (typingIndicator) {
        typingIndicator.style.display = 'flex';
        scrollToBottom();
      }

      try {
        // Attempt POST to secure serverless endpoint /api/chat
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify({ message: question }),
        });

        if (response.ok) {
          const data = await response.json();
          if (data && data.answer) {
            appendMessage('assistant', data.answer, data.action);
            return;
          }
        }

        // If serverless endpoint returned error or fallback mode
        const offline = getOfflineAnswer(question);
        appendMessage('assistant', offline.text, offline.action);
      } catch (err) {
        // Pure static or offline fallback: zero downtime, 100% reliable
        const offline = getOfflineAnswer(question);
        appendMessage('assistant', offline.text, offline.action);
      } finally {
        isThinking = false;
        if (typingIndicator) typingIndicator.style.display = 'none';
        sendBtn.disabled = userInput.value.trim().length === 0;
        userInput.focus();
        scrollToBottom();
      }
    }

    inputForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = userInput.value.trim();
      if (val && !isThinking) {
        submitQuestion(val);
      }
    });
  });
</script>

<style>
  .ai-widget-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 9999;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
  }

  /* 1. Floating Launch Button */
  .ai-floating-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #090d16 0%, #111827 100%);
    border: 1px solid rgba(56, 189, 248, 0.45);
    border-radius: var(--radius-full, 9999px);
    color: var(--text-primary, #f8fafc);
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(56, 189, 248, 0.25);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-floating-btn:hover {
    transform: translateY(-3px) scale(1.02);
    border-color: rgba(56, 189, 248, 0.8);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.7), 0 0 30px rgba(56, 189, 248, 0.45);
  }

  .ai-btn-glow {
    position: absolute;
    inset: -2px;
    border-radius: var(--radius-full, 9999px);
    background: radial-gradient(circle at 50% 50%, rgba(56, 189, 248, 0.3), transparent 70%);
    filter: blur(8px);
    pointer-events: none;
    z-index: 0;
  }

  .ai-btn-icon-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
  }

  .ai-btn-pulse-dot {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 7px;
    height: 7px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 6px #10b981;
    animation: aiPulse 1.8s infinite;
  }

  .ai-btn-label {
    position: relative;
    z-index: 1;
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* 2. Chat Window Modal */
  .ai-chat-card {
    position: absolute;
    bottom: 64px;
    right: 0;
    width: 380px;
    max-width: calc(100vw - 32px);
    height: 540px;
    max-height: calc(100vh - 100px);
    background: rgba(11, 15, 25, 0.96);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(56, 189, 248, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: aiSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10000;
  }

  @keyframes aiSlideUp {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  /* Chat Header */
  .ai-chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: rgba(15, 23, 42, 0.85);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .ai-header-info {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-avatar-badge {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(168, 85, 247, 0.2));
    border: 1px solid rgba(56, 189, 248, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
  }

  .ai-status-online {
    position: absolute;
    bottom: -2px;
    right: -2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #10b981;
    border: 2px solid #0f172a;
    box-shadow: 0 0 6px #10b981;
  }

  .ai-header-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
