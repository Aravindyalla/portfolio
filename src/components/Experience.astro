---
// Experience.astro
import { portfolioData } from '../data/portfolio';

const { experiences } = portfolioData;
---

<section class="experience-section" id="experience">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <div class="section-tag">
        <span class="dot"></span>
        <span>Career Trajectory</span>
      </div>
      <h2 class="section-title">
        Professional <span class="text-gradient">Experience</span>
      </h2>
      <p class="section-subtitle">
        Hands-on enterprise engineering across production media workflows, LLM deployments, and backend services.
      </p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="timeline-container">
      {experiences.map((exp) => (
        <div class="timeline-card glass-card">
          <!-- Timeline Pin -->
          <div class="timeline-pin">
            <span class="pin-ring"></span>
            <span class="pin-dot"></span>
          </div>

          <div class="experience-main">
            <!-- Header Bar -->
            <div class="exp-header-bar">
              <div class="exp-role-info">
                <span class="exp-role">{exp.role}</span>
                <span class="exp-company-text">
                  @ <strong class="company-name">{exp.company}</strong>
                </span>
              </div>
              <div class="exp-period-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>{exp.period}</span>
              </div>
            </div>

            <!-- Transition Highlight Badge -->
            <div class="transition-pill">
              <span class="transition-icon">🚀</span>
              <span class="transition-text">Career Growth: <strong>AI Intern</strong> &rarr; Transitioned to Full-Time <strong>AI Engineer</strong></span>
            </div>

            <div class="exp-location-tag">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>{exp.location}</span>
              <span class="divider">&bull;</span>
              <span class="exp-type">{exp.type}</span>
            </div>

            <p class="exp-overview">{exp.description}</p>

            <!-- Key Responsibilities & Achievements -->
            <div class="exp-highlights-block">
              <h4 class="highlights-title">Key Contributions & Engineering Impact:</h4>
              <ul class="highlights-list">
                {exp.highlights.map((hl) => (
                  <li class="highlight-item">
                    <span class="hl-marker">&bull;</span>
                    <span>{hl}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Tech Badges -->
            <div class="exp-tech-row">
              <span class="exp-tech-label">CORE TECHNOLOGIES:</span>
              <div class="exp-tech-pills">
                {exp.technologies.map((t) => (
                  <span class="tech-badge">{t}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    position: relative;
    background: linear-gradient(180deg, transparent 0%, rgba(12, 16, 24, 0.45) 50%, transparent 100%);
  }

  .timeline-container {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
    padding-left: 36px;
    border-left: 2px dashed rgba(56, 189, 248, 0.25);
  }

  .timeline-card {
    position: relative;
    padding: 32px;
    margin-bottom: 24px;
    background: rgba(12, 16, 24, 0.85);
  }

  /* Timeline Pin */
  .timeline-pin {
    position: absolute;
    left: -48px;
    top: 36px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pin-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--sky);
    background: #06080d;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.5);
  }
  .pin-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sky);
    position: relative;
    z-index: 2;
  }

  /* Main Info */
  .experience-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .exp-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
  }
  .exp-role-info {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }
  .exp-role {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .exp-company-text {
    font-size: 1.15rem;
    color: var(--text-secondary);
  }
  .company-name {
    color: var(--sky);
  }

  .exp-period-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: var(--sky);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  /* Career Transition Pill */
  .transition-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-md);
    background: rgba(168, 85, 247, 0.08);
    border: 1px solid rgba(168, 85, 247, 0.25);
    color: #e9d5ff;
    font-size: 0.875rem;
    align-self: flex-start;
  }
  .transition-pill strong {
    color: #f3e8ff;
  }

  .exp-location-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .divider {
    color: var(--text-dim);
  }

  .exp-overview {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Highlights */
  .exp-highlights-block {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    padding: 16px 20px;
  }
  .highlights-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    font-family: var(--font-mono);
    margin-bottom: 12px;
    letter-spacing: 0.04em;
  }
  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .hl-marker {
    color: var(--sky);
    font-size: 1.2rem;
    line-height: 1;
  }

  /* Tech Row */
  .exp-tech-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }
  .exp-tech-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .exp-tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 640px) {
    .timeline-container {
      padding-left: 20px;
    }
    .timeline-pin {
      left: -32px;
    }
    .timeline-card {
      padding: 20px;
    }
    .exp-role-info {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
