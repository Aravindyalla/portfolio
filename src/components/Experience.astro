---
// Experience.astro
import { portfolioData } from '../data/portfolio';

const { experiences } = portfolioData;
---

<section class="experience-section" id="experience">
  <div class="container">
    <!-- Header -->
    <div class="section-header">
      <div class="section-tag">
        <span class="dot"></span>
        <span>Career Trajectory</span>
      </div>
      <h2 class="section-title">
        Professional <span class="text-gradient">Experience</span>
      </h2>
      <p class="section-subtitle">
        Building and deploying production AI applications, backend services, and document intelligence workflows.
      </p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="timeline-container">
      {experiences.map((exp) => (
        <div class="timeline-card glass-card">
          <!-- Timeline Pin -->
          <div class="timeline-pin">
            <span class="pin-ring"></span>
            <span class="pin-dot"></span>
          </div>

          <div class="experience-main">
            <!-- Header Bar -->
            <div class="exp-header-bar">
              <div class="exp-role-info">
                <h3 class="exp-role">{exp.role}</h3>
                <span class="exp-company-text">
                  @ <strong class="company-name">{exp.company}</strong>
                </span>
              </div>
              <div class="exp-location-tag">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>{exp.location}</span>
              </div>
            </div>

            <!-- Transition & Timeline Periods -->
            <div class="transition-container">
              <div class="transition-header">
                <span class="transition-tag">CAREER MILESTONE</span>
                <span class="transition-headline">Transition from Intern &rarr; Full-Time</span>
              </div>
              <div class="roles-stepper">
                {exp.roles.map((r, idx) => (
                  <div class={`role-step ${r.type === 'Full-Time' ? 'active' : ''}`}>
                    <div class="step-indicator">
                      <span class="step-dot"></span>
                      {idx < exp.roles.length - 1 && <span class="step-line"></span>}
                    </div>
                    <div class="step-details">
                      <div class="step-title-row">
                        <span class="step-title">{r.title}</span>
                        <span class="step-badge">{r.type}</span>
                      </div>
                      <span class="step-period">{r.period}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <p class="exp-overview">{exp.description}</p>

            <!-- Key Responsibilities & Achievements -->
            <div class="exp-highlights-block">
              <h4 class="highlights-title">Key Responsibilities & Contributions:</h4>
              <ul class="highlights-list">
                {exp.highlights.map((hl) => (
                  <li class="highlight-item">
                    <span class="hl-marker">&bull;</span>
                    <span>{hl}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Tech Badges -->
            <div class="exp-tech-row">
              <span class="exp-tech-label">CORE TECHNOLOGIES:</span>
              <div class="exp-tech-pills">
                {exp.technologies.map((t) => (
                  <span class="tech-badge highlight">{t}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experience-section {
    position: relative;
    background: linear-gradient(180deg, transparent 0%, rgba(12, 16, 24, 0.45) 50%, transparent 100%);
  }

  .timeline-container {
    position: relative;
    max-width: 980px;
    margin: 0 auto;
    padding-left: 36px;
    border-left: 2px dashed rgba(56, 189, 248, 0.25);
  }

  .timeline-card {
    position: relative;
    padding: 32px;
    margin-bottom: 24px;
    background: rgba(12, 16, 24, 0.85);
  }

  /* Timeline Pin */
  .timeline-pin {
    position: absolute;
    left: -48px;
    top: 36px;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pin-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--sky);
    background: #06080d;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.5);
  }
  .pin-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sky);
    position: relative;
    z-index: 2;
  }

  /* Main Info */
  .experience-main {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .exp-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
  }
  .exp-role-info {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }
  .exp-role {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .exp-company-text {
    font-size: 1.15rem;
    color: var(--text-secondary);
  }
  .company-name {
    color: var(--sky);
  }

  .exp-location-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  /* Roles Transition Box */
  .transition-container {
    background: rgba(56, 189, 248, 0.04);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: var(--radius-md);
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .transition-header {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .transition-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--sky);
    background: rgba(56, 189, 248, 0.12);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }
  .transition-headline {
    font-size: 0.92rem;
    font-weight: 700;
    color: #e2e8f0;
  }

  .roles-stepper {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .role-step {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
  }
  .role-step.active {
    background: rgba(16, 185, 129, 0.06);
    border-color: rgba(16, 185, 129, 0.3);
  }
  .step-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 4px;
  }
  .step-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--sky);
    box-shadow: 0 0 8px var(--sky);
  }
  .role-step.active .step-dot {
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }
  .step-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }
  .step-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .step-title {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .step-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 2px 7px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
  }
  .role-step.active .step-badge {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
  }
  .step-period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .exp-overview {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* Highlights */
  .exp-highlights-block {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    padding: 18px 22px;
  }
  .highlights-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
    font-family: var(--font-mono);
    margin-bottom: 14px;
    letter-spacing: 0.04em;
  }
  .highlights-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .highlight-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.93rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .hl-marker {
    color: var(--sky);
    font-size: 1.2rem;
    line-height: 1;
  }

  /* Tech Row */
  .exp-tech-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--border-subtle);
  }
  .exp-tech-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }
  .exp-tech-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  @media (max-width: 768px) {
    .roles-stepper {
      grid-template-columns: 1fr;
    }
    .timeline-container {
      padding-left: 20px;
    }
    .timeline-pin {
      left: -32px;
    }
    .timeline-card {
      padding: 20px;
    }
    .exp-role-info {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
