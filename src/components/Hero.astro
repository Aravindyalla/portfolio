---
// Hero.astro
import { portfolioData } from '../data/portfolio';

const { personal, stats } = portfolioData;
---

<section class="hero-section" id="hero">
  <div class="container hero-container">
    <!-- Hero Left: Content -->
    <div class="hero-content">
      <!-- Status Badge -->
      <div class="status-pill" data-aos="fade-down">
        <span class="status-dot"></span>
        <span class="status-text">{personal.status}</span>
        <span class="status-location">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          {personal.location}
        </span>
      </div>

      <!-- Main Headline & Name -->
      <h1 class="hero-title">
        Hi, I'm <span class="hero-name text-gradient">{personal.name}</span>
        <span class="hero-role-block">
          <span class="terminal-prompt">&gt;</span> {personal.role}
        </span>
      </h1>

      <!-- Specialized Headline -->
      <div class="hero-headline-wrapper">
        <p class="hero-headline">
          {personal.headline}
        </p>
      </div>

      <!-- Bio / Subtext -->
      <p class="hero-description">
        {personal.shortDescription}
      </p>

      <!-- Primary Action Buttons -->
      <div class="hero-actions">
        <!-- Download Resume Button -->
        <a
          href={personal.resumeUrl}
          download="Aravind_Naidu_Yalla_Resume.pdf"
          class="btn btn-lg btn-glow"
          id="hero-resume-download"
        >
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Resume</span>
        </a>

        <!-- Projects link -->
        <a href="#projects" class="btn btn-lg btn-primary" id="hero-view-projects">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
          <span>Explore Projects</span>
        </a>

        <!-- Email Button -->
        <a
          href={`mailto:${personal.email}`}
          class="btn btn-lg btn-secondary"
          id="hero-email-btn"
          title={`Email ${personal.email}`}
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <span>Get in Touch</span>
        </a>
      </div>

      <!-- Social Quick Links Bar -->
      <div class="hero-social-strip">
        <span class="social-label">Connect:</span>
        <div class="social-button-group">
          <!-- LinkedIn Button -->
          <a
            href={personal.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="social-pill-btn"
            id="hero-linkedin-btn"
            aria-label="LinkedIn Profile"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect x="2" y="9" width="4" height="12"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
            <span>LinkedIn</span>
          </a>

          <!-- GitHub Button -->
          <a
            href={personal.github}
            target="_blank"
            rel="noopener noreferrer"
            class="social-pill-btn"
            id="hero-github-btn"
            aria-label="GitHub Profile"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
            </svg>
            <span>GitHub</span>
          </a>

          <!-- Email Button -->
          <button
            type="button"
            class="social-pill-btn"
            data-copy={personal.email}
            data-copy-msg="Email address copied to clipboard!"
            id="hero-copy-email-btn"
            aria-label="Copy Email address"
            title="Click to copy email address"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>{personal.email}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Hero Right: Futuristic Interactive Visual Card -->
    <div class="hero-visual">
      <div class="profile-card-wrapper">
        <!-- Ambient Halo -->
        <div class="profile-halo"></div>

        <div class="profile-card glass-card">
          <!-- Terminal Header Bar -->
          <div class="card-terminal-bar">
            <div class="terminal-dots">
              <span class="dot-red"></span>
              <span class="dot-yellow"></span>
              <span class="dot-green"></span>
            </div>
            <div class="terminal-title">aravind@pmf-ai-node:~</div>
            <div class="terminal-badge">ONLINE</div>
          </div>

          <!-- Avatar with tech frame -->
          <div class="avatar-container">
            <div class="avatar-ring">
              <img
                src={personal.avatar}
                alt={personal.name}
                class="avatar-image"
                width="320"
                height="320"
                loading="eager"
              />
            </div>
            
            <!-- Floating Badge: Model Serving -->
            <div class="floating-chip chip-top-right">
              <span class="chip-dot"></span>
              <span class="chip-text">Ollama &bull; Qdrant</span>
            </div>

            <!-- Floating Badge: FastAPI -->
            <div class="floating-chip chip-bottom-left">
              <span class="chip-icon">&lambda;</span>
              <span class="chip-text">FastAPI Microservices</span>
            </div>
          </div>

          <!-- Quick Info Strip -->
          <div class="profile-card-meta">
            <div class="meta-item">
              <span class="meta-label">CURRENT ROLE</span>
              <span class="meta-value">{personal.role}</span>
            </div>
            <div class="meta-divider"></div>
            <div class="meta-item">
              <span class="meta-label">COMPANY</span>
              <span class="meta-value">{personal.company}</span>
            </div>
          </div>

          <!-- Code Snippet Accordion -->
          <div class="code-preview-snippet">
            <div class="code-line"><span class="c-kw">from</span> fastapi <span class="c-kw">import</span> FastAPI</div>
            <div class="code-line"><span class="c-kw">from</span> qdrant_client <span class="c-kw">import</span> QdrantClient</div>
            <div class="code-line"><span class="c-kw">class</span> <span class="c-fn">EnterpriseRAG</span>:</div>
            <div class="code-line indent"><span class="c-kw">async def</span> <span class="c-fn">query</span>(self, prompt: str):</div>
            <div class="code-line indent2"><span class="c-ret">return await</span> self.synthesize(prompt)</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Key Metrics / Stats Strip -->
  <div class="container hero-stats-container">
    <div class="stats-grid">
      {stats.map((stat) => (
        <div class="stat-card glass-card">
          <div class="stat-value text-gradient">{stat.value}</div>
          <div class="stat-label">{stat.label}</div>
          <div class="stat-detail">{stat.detail}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding-top: 56px;
    padding-bottom: 72px;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  /* Status Pill */
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    font-size: 0.825rem;
    font-family: var(--font-mono);
    color: #6ee7b7;
    margin-bottom: 24px;
  }
  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 10px #10b981;
    animation: pulseGlow 2s infinite ease-in-out;
  }
  .status-location {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-muted);
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    padding-left: 10px;
    margin-left: 4px;
  }

  /* Title */
  .hero-title {
    font-size: clamp(2.4rem, 5.2vw, 3.8rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 16px;
  }
  .hero-role-block {
    display: block;
    font-size: clamp(1.8rem, 3.8vw, 2.7rem);
    color: #e2e8f0;
    margin-top: 6px;
  }
  .terminal-prompt {
    color: var(--sky);
    font-family: var(--font-mono);
    font-weight: 700;
  }

  /* Headline Banner */
  .hero-headline-wrapper {
    margin-bottom: 20px;
  }
  .hero-headline {
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    font-weight: 600;
    color: var(--sky);
    letter-spacing: -0.01em;
  }

  /* Description */
  .hero-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 620px;
    margin-bottom: 32px;
  }
  .hero-description strong {
    color: var(--text-primary);
    font-weight: 600;
  }
  .hero-description em {
    color: #7dd3fc;
    font-style: normal;
    font-weight: 500;
  }

  /* Action Buttons */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin-bottom: 32px;
  }

  /* Social Strip */
  .hero-social-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
  }
  .social-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .social-button-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  .social-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 7px 14px;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .social-pill-btn:hover {
    color: var(--sky);
    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.3);
    transform: translateY(-1px);
  }

  /* Profile Visual Card */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .profile-card-wrapper {
    position: relative;
    width: 100%;
    max-width: 440px;
  }
  .profile-halo {
    position: absolute;
    inset: -15px;
    background: radial-gradient(circle at 50% 50%, rgba(6, 182, 212, 0.2), rgba(168, 85, 247, 0.15), transparent 70%);
    filter: blur(35px);
    border-radius: 30px;
    z-index: 0;
  }
  .profile-card {
    position: relative;
    z-index: 1;
    background: rgba(12, 16, 24, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-xl);
    padding: 20px;
    backdrop-filter: blur(20px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  /* Card Terminal Top */
  .card-terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
  }
  .terminal-dots {
    display: flex;
    gap: 6px;
  }
  .terminal-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot-red { background: #ef4444; }
  .dot-yellow { background: #eab308; }
  .dot-green { background: #22c55e; }
  .terminal-title {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .terminal-badge {
    font-size: 0.68rem;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  /* Avatar Area */
  .avatar-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    overflow: visible;
    margin-bottom: 16px;
  }
  .avatar-ring {
    width: 100%;
    height: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(56, 189, 248, 0.25);
    background: #090d14;
  }
  .avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .profile-card:hover .avatar-image {
    transform: scale(1.02);
  }

  /* Floating Chips */
  .floating-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: var(--radius-full);
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #f1f5f9;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
    z-index: 10;
    animation: floatSlow 4s ease-in-out infinite;
  }
  .chip-top-right {
    top: -12px;
    right: -12px;
  }
  .chip-bottom-left {
    bottom: -12px;
    left: -12px;
    animation-delay: -2s;
  }
  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sky);
    box-shadow: 0 0 6px var(--sky);
  }
  .chip-icon {
    color: var(--violet);
    font-weight: 700;
  }

  /* Card Meta */
  .profile-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    margin-bottom: 12px;
  }
  .meta-item {
    display: flex;
    flex-direction: column;
  }
  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  .meta-value {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
  }
  .meta-divider {
    width: 1px;
    height: 24px;
    background: var(--border-subtle);
  }

  /* Code snippet inside card */
  .code-preview-snippet {
    background: #06090e;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-md);
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: #94a3b8;
  }
  .code-line {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .c-kw { color: #f43f5e; }
  .c-fn { color: #38bdf8; }
  .c-ret { color: #a855f7; }
  .indent { padding-left: 14px; }
  .indent2 { padding-left: 28px; }

  /* Stats Grid */
  .hero-stats-container {
    margin-top: 56px;
    position: relative;
    z-index: 2;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .stat-card {
    padding: 20px;
    text-align: left;
    border-radius: var(--radius-lg);
  }
  .stat-value {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .stat-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2px;
  }
  .stat-detail {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  @media (max-width: 980px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .hero-content {
      order: 1;
    }
    .hero-visual {
      order: 2;
    }
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn {
      width: 100%;
    }
    .profile-card-wrapper {
      max-width: 320px;
    }
  }
</style>
