---
// SEO.astro
import { portfolioData } from '../data/portfolio';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title = `${portfolioData.personal.name} | ${portfolioData.personal.role} & GenAI Specialist`,
  description = `${portfolioData.personal.name} is an ${portfolioData.personal.role} at ${portfolioData.personal.company} specializing in Generative AI, Large Language Models (LLMs), RAG systems, Qdrant vector databases, and Python FastAPI APIs.`,
  image = portfolioData.personal.ogImage,
  article = false,
} = Astro.props;

// Determine base site URL: precedence: Astro.site -> process.env.SITE_URL -> fallback
const siteOrigin = Astro.site 
  ? Astro.site.toString().replace(/\/$/, '')
  : (process.env.SITE_URL || 'https://aravindnaidu.dev').replace(/\/$/, '');

const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageUrl = new URL(image, siteOrigin).href;

// JSON-LD Structured Data Schema for Person & WebSite
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteOrigin}/#person`,
      name: portfolioData.personal.name,
      jobTitle: portfolioData.personal.role,
      worksFor: {
        '@type': 'Organization',
        name: portfolioData.personal.company,
      },
      description: portfolioData.personal.about,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Hyderabad',
        addressCountry: 'IN',
      },
      email: portfolioData.personal.email,
      telephone: portfolioData.personal.phone,
      sameAs: [
        portfolioData.personal.linkedin,
        portfolioData.personal.github,
      ],
      knowsAbout: [
        'Artificial Intelligence',
        'Large Language Models (LLMs)',
        'Retrieval-Augmented Generation (RAG)',
        'Vector Databases',
        'Qdrant',
        'Python',
        'FastAPI',
        'Generative AI',
        'Semantic Search',
        'PostgreSQL',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteOrigin}/#website`,
      url: siteOrigin,
      name: `${portfolioData.personal.name} - AI Software Engineer Portfolio`,
      description: description,
      publisher: {
        '@id': `${siteOrigin}/#person`,
      },
      inLanguage: 'en-US',
    },
  ],
};
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={portfolioData.personal.name} />
<meta name="keywords" content="Aravind Naidu Yalla, AI Software Engineer, AI Developer, Generative AI, LLMs, Large Language Models, RAG, Retrieval-Augmented Generation, Qdrant, FastAPI, Python AI Engineer, Hyderabad AI Engineer, People Media Factory, Ollama, Hugging Face, Vector Search, PostgreSQL" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="robots" content="index, follow" />
<link rel="canonical" href={canonicalUrl} />

<!-- Favicon & Brand Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<meta name="theme-color" content="#06080d" />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={`${portfolioData.personal.name} - AI Engineer`} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${portfolioData.personal.name} - AI Engineer Portfolio Preview`} />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={`${portfolioData.personal.name} - AI Engineer Portfolio Preview`} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
