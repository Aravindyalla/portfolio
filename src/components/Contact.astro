---
// Contact.astro
import { portfolioData } from '../data/portfolio';

const { personal } = portfolioData;
const emailSubject = encodeURIComponent('Portfolio Contact - Aravind Naidu Yalla');
const mailtoUrl = `mailto:${personal.email}?subject=${emailSubject}`;
---

<section class="contact-section" id="contact">
  <div class="container">
    <div class="contact-card glass-card">
      <!-- Ambient Glow Behind Contact -->
      <div class="contact-halo" aria-hidden="true"></div>

      <!-- Header Content -->
      <div class="contact-header">
        <div class="section-tag">
          <span class="dot"></span>
          <span>Get In Touch</span>
        </div>

        <h2 class="contact-title">
          Let's Build Intelligent <span class="text-gradient">AI Solutions</span> Together
        </h2>

        <p class="contact-subtitle">
          AI Software Engineer with 1 year of hands-on experience building and deploying AI-powered applications and backend systems. Experienced in Python, FastAPI, LLMs, RAG, vector databases, and PostgreSQL. Let's connect!
        </p>

        <!-- Availability Indicator Box -->
        <div class="availability-box">
          <div class="avail-left">
            <span class="status-pulse-dot"></span>
            <div>
              <span class="avail-status">Available for AI Software Engineering Opportunities</span>
              <span class="avail-loc">{personal.location} &bull; {personal.company}</span>
            </div>
          </div>
          <span class="response-time-pill">&lt; 24h Response Time</span>
        </div>
      </div>

      <!-- Main Contact Grid: Quick Action Buttons & Direct Contact Form -->
      <div class="contact-grid">
        <!-- Left: Quick Direct Connect Buttons & Details -->
        <div class="contact-left-col">
          <h3 class="col-heading">Direct Connect</h3>
          <p class="col-subtext">Reach out directly via email, phone, or professional networks.</p>

          <div class="contact-buttons-grid">
            <!-- 1. Email Me Button -->
            <a
              href={mailtoUrl}
              class="contact-action-btn btn-email"
              id="contact-email-link"
              data-copy={personal.email}
              data-copy-msg="Email copied: aravindyallao@gmail.com! Opening mail app..."
            >
              <div class="btn-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="btn-text-wrap">
                <span class="btn-main-label">Email Me</span>
                <span class="btn-sub-label">{personal.email}</span>
              </div>
              <span class="action-arrow">&rarr;</span>
            </a>

            <!-- 1b. Compose in Gmail (Web Browser) -->
            <a
              href={`https://mail.google.com/mail/?view=cm&fs=1&to=${personal.email}&su=${emailSubject}`}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-action-btn btn-gmail"
              id="contact-gmail-link"
            >
              <div class="btn-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </div>
              <div class="btn-text-wrap">
                <span class="btn-main-label">Open in Gmail (Web)</span>
                <span class="btn-sub-label">Launch compose tab directly</span>
              </div>
              <span class="action-arrow">&rarr;</span>
            </a>

            <!-- 2. LinkedIn Button -->
            <a
              href={personal.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-action-btn btn-linkedin"
              id="contact-linkedin-link"
            >
              <div class="btn-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                  <rect x="2" y="9" width="4" height="12"></rect>
                  <circle cx="4" cy="4" r="2"></circle>
                </svg>
              </div>
              <div class="btn-text-wrap">
                <span class="btn-main-label">LinkedIn</span>
                <span class="btn-sub-label">aravind-naidu-yalla</span>
              </div>
              <span class="action-arrow">&rarr;</span>
            </a>

            <!-- 3. GitHub Button -->
            <a
              href={personal.github}
              target="_blank"
              rel="noopener noreferrer"
              class="contact-action-btn btn-github"
              id="contact-github-link"
            >
              <div class="btn-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                </svg>
              </div>
              <div class="btn-text-wrap">
                <span class="btn-main-label">GitHub</span>
                <span class="btn-sub-label">@Aravindyalla</span>
              </div>
              <span class="action-arrow">&rarr;</span>
            </a>

            <!-- 4. Phone / Call Button -->
            <a
              href={`tel:${personal.phone}`}
              class="contact-action-btn btn-phone"
              id="contact-phone-link"
            >
              <div class="btn-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div class="btn-text-wrap">
                <span class="btn-main-label">Call / Phone</span>
                <span class="btn-sub-label">{personal.phone}</span>
              </div>
              <span class="action-arrow">&rarr;</span>
            </a>

            <!-- 5. Download Resume Button (Original Verified Resume) -->
            <a
              href={personal.resumeUrl}
              target="_blank"
              download="Aravind_Naidu_Yalla_Resume.pdf"
              class="contact-action-btn btn-resume"
              id="contact-resume-download"
            >
              <div class="btn-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="7 10 12 15 17 10"></polyline>
                  <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
              </div>
              <div class="btn-text-wrap">
                <span class="btn-main-label">Download Resume</span>
                <span class="btn-sub-label">PDF &bull; Original Resume</span>
              </div>
              <span class="action-arrow">&darr;</span>
            </a>
          </div>

          <!-- Quick Copy Details -->
          <div class="copy-email-strip">
            <div class="copy-box">
              <span class="copy-label">EMAIL:</span>
              <code class="copy-code">{personal.email}</code>
              <button
                type="button"
                class="btn btn-secondary btn-sm"
                data-copy={personal.email}
                data-copy-msg="Email address copied to clipboard!"
                aria-label="Copy Email address"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span>Copy</span>
              </button>
            </div>

            <div class="copy-box">
              <span class="copy-label">PHONE:</span>
              <a href={`tel:${personal.phone}`} class="copy-code" style="text-decoration: none;">{personal.phone}</a>
              <button
                type="button"
                class="btn btn-secondary btn-sm"
                data-copy={personal.phone}
                data-copy-msg="Phone number copied to clipboard!"
                aria-label="Copy Phone number"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span>Copy</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Right: Modern Contact Form -->
        <div class="contact-right-col">
          <div class="form-container">
            <h3 class="col-heading">Send a Message</h3>
            <p class="col-subtext">Fill out the form below and I will get back to you promptly.</p>

            <form id="portfolio-contact-form" class="contact-form" novalidate>
              <!-- Name Field -->
              <div class="form-group">
                <label for="contact-name" class="form-label">
                  Your Name <span class="required-star">*</span>
                </label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  class="form-input"
                  placeholder="e.g. Alex Johnson"
                  required
                  minlength="2"
                  autocomplete="name"
                />
                <span class="form-field-error" id="name-error"></span>
              </div>

              <!-- Email Field -->
              <div class="form-group">
                <label for="contact-email" class="form-label">
                  Your Email <span class="required-star">*</span>
                </label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  class="form-input"
                  placeholder="e.g. alex@example.com"
                  required
                  autocomplete="email"
                />
                <span class="form-field-error" id="email-error"></span>
              </div>

              <!-- Subject Field -->
              <div class="form-group">
                <label for="contact-subject" class="form-label">
                  Subject <span class="required-star">*</span>
                </label>
                <input
                  type="text"
                  id="contact-subject"
                  name="subject"
                  class="form-input"
                  placeholder="e.g. AI Engineer Opportunity / Project Inquiry"
                  required
                  minlength="2"
                />
                <span class="form-field-error" id="subject-error"></span>
              </div>

              <!-- Message Field -->
              <div class="form-group">
                <label for="contact-message" class="form-label">
                  Message <span class="required-star">*</span>
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  class="form-textarea"
                  rows="4"
                  placeholder="Tell me about your team, project requirements, or opportunity..."
                  required
                  minlength="5"
                ></textarea>
                <span class="form-field-error" id="message-error"></span>
              </div>

              <!-- Status Feedback Banners -->
              <div id="form-success-banner" class="form-status-banner success-banner" role="alert" style="display: none;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="status-icon">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <div class="status-content">
                  <p class="status-text">Thanks for reaching out! Your message has been sent successfully.</p>
                </div>
              </div>

              <div id="form-error-banner" class="form-status-banner error-banner" role="alert" style="display: none;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="status-icon">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <div class="status-content">
                  <p class="status-text" id="form-error-message">Something went wrong while sending your message. Please try again or contact me directly by email.</p>
                  <div class="error-action-row" id="error-action-row">
                    <a id="error-gmail-fallback" href="#" target="_blank" rel="noopener noreferrer" class="direct-email-btn btn-error-gmail">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                      <span>Send via Gmail (Web)</span> &rarr;
                    </a>
                    <a id="error-mailto-fallback" href={mailtoUrl} class="direct-email-btn">
                      <span>Send via Mail App</span> &rarr;
                    </a>
                  </div>
                </div>
              </div>

              <!-- Submit Button -->
              <button type="submit" id="contact-submit-btn" class="form-submit-btn">
                <span class="btn-spinner" id="btn-spinner" aria-hidden="true"></span>
                <span class="btn-text" id="btn-text">Send Message</span>
                <svg id="btn-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Client-side Contact Form Handler with Validation and Secure Endpoint Call
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('portfolio-contact-form') as HTMLFormElement | null;
    if (!form) return;

    const nameInput = document.getElementById('contact-name') as HTMLInputElement;
    const emailInput = document.getElementById('contact-email') as HTMLInputElement;
    const subjectInput = document.getElementById('contact-subject') as HTMLInputElement;
    const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;
    const submitBtn = document.getElementById('contact-submit-btn') as HTMLButtonElement;
    const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;
    const btnText = document.getElementById('btn-text') as HTMLElement;
    const btnArrow = document.getElementById('btn-arrow') as HTMLElement;
    const successBanner = document.getElementById('form-success-banner') as HTMLElement;
    const errorBanner = document.getElementById('form-error-banner') as HTMLElement;
    const errorMailto = document.getElementById('error-mailto-fallback') as HTMLAnchorElement;
    const errorGmail = document.getElementById('error-gmail-fallback') as HTMLAnchorElement;
    const errorMessage = document.getElementById('form-error-message') as HTMLElement;

    // Field Error Elements
    const nameError = document.getElementById('name-error');
    const emailError = document.getElementById('email-error');
    const subjectError = document.getElementById('subject-error');
    const messageError = document.getElementById('message-error');

    function validateEmail(val: string): boolean {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
    }

    function clearErrors() {
      if (nameError) nameError.textContent = '';
      if (emailError) emailError.textContent = '';
      if (subjectError) subjectError.textContent = '';
      if (messageError) messageError.textContent = '';
      if (successBanner) successBanner.style.display = 'none';
      if (errorBanner) errorBanner.style.display = 'none';
    }

    function validateForm(): boolean {
      clearErrors();
      let isValid = true;

      const nameVal = nameInput?.value?.trim() || '';
      const emailVal = emailInput?.value?.trim() || '';
      const subjectVal = subjectInput?.value?.trim() || '';
      const messageVal = messageInput?.value?.trim() || '';

      if (nameVal.length < 2) {
        if (nameError) nameError.textContent = 'Please enter your name (at least 2 characters).';
        isValid = false;
      }

      if (!validateEmail(emailVal)) {
        if (emailError) emailError.textContent = 'Please enter a valid email address.';
        isValid = false;
      }

      if (subjectVal.length < 2) {
        if (subjectError) subjectError.textContent = 'Please enter a subject.';
        isValid = false;
      }

      if (messageVal.length < 5) {
        if (messageError) messageError.textContent = 'Please enter your message (at least 5 characters).';
        isValid = false;
      }

      return isValid;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!validateForm()) {
        return;
      }

      const payload = {
        name: nameInput.value.trim(),
        email: emailInput.value.trim(),
        subject: subjectInput.value.trim(),
        message: messageInput.value.trim(),
      };

      // Set Loading State
      submitBtn.disabled = true;
      btnSpinner.style.display = 'inline-block';
      btnText.textContent = 'Sending Message...';
      if (btnArrow) btnArrow.style.display = 'none';
      if (successBanner) successBanner.style.display = 'none';
      if (errorBanner) errorBanner.style.display = 'none';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify(payload),
        });

        const data = await response.json().catch(() => null);

        if (response.ok && data?.success) {
          // Success State
          form.reset();
          if (successBanner) {
            successBanner.style.display = 'flex';
            successBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
          if (window.showToast) {
            window.showToast('Message sent successfully!');
          }
        } else {
          // Error or unconfigured backend state
          if (errorBanner) {
            errorBanner.style.display = 'flex';
            const emailSubj = encodeURIComponent(`Portfolio Contact: ${payload.subject}`);
            const emailBody = encodeURIComponent(`Hi Aravind,\n\nName: ${payload.name}\nEmail: ${payload.email}\nSubject: ${payload.subject}\n\nMessage:\n${payload.message}`);
            const fallbackGmail = `https://mail.google.com/mail/?view=cm&fs=1&to=aravindyallao@gmail.com&su=${emailSubj}&body=${emailBody}`;
            const fallbackMailto = `mailto:aravindyallao@gmail.com?subject=${emailSubj}&body=${emailBody}`;

            if (errorGmail) errorGmail.href = data?.gmailUrl || fallbackGmail;
            if (errorMailto) errorMailto.href = data?.mailtoUrl || fallbackMailto;

            if (errorMessage) {
              errorMessage.textContent = data?.error || 'Email service not configured yet. Click below to send directly via Gmail or Mail client with your message prefilled:';
            }

            errorBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        }
      } catch (err) {
        // Network or fetch failure
        console.error('Contact form error:', err);
        if (errorBanner) {
          errorBanner.style.display = 'flex';
          const emailSubj = encodeURIComponent(`Portfolio Contact: ${payload.subject}`);
          const emailBody = encodeURIComponent(`Hi Aravind,\n\nName: ${payload.name}\nEmail: ${payload.email}\nSubject: ${payload.subject}\n\nMessage:\n${payload.message}`);
          const fallbackGmail = `https://mail.google.com/mail/?view=cm&fs=1&to=aravindyallao@gmail.com&su=${emailSubj}&body=${emailBody}`;
          const fallbackMailto = `mailto:aravindyallao@gmail.com?subject=${emailSubj}&body=${emailBody}`;

          if (errorGmail) errorGmail.href = fallbackGmail;
          if (errorMailto) errorMailto.href = fallbackMailto;

          if (errorMessage) {
            errorMessage.textContent = 'Unable to connect to background email service. You can send this message right now with 1 click using Gmail or your email app below:';
          }

          errorBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      } finally {
        // Reset button state
        submitBtn.disabled = false;
        btnSpinner.style.display = 'none';
        btnText.textContent = 'Send Message';
        if (btnArrow) btnArrow.style.display = 'inline-block';
      }
    });
  });
</script>

<style>
  .contact-section {
    position: relative;
    padding-bottom: 96px;
  }

  .contact-card {
    position: relative;
    padding: 48px;
    background: rgba(12, 16, 24, 0.92);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .contact-halo {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.18), rgba(168, 85, 247, 0.15), transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    z-index: 0;
  }

  .contact-header {
    position: relative;
    z-index: 1;
    max-width: 860px;
    margin: 0 auto 40px auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .contact-title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  .contact-subtitle {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 32px;
    max-width: 720px;
  }

  /* Availability Box */
  .availability-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    width: 100%;
    padding: 16px 20px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
  }
  .avail-left {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
  }
  .status-pulse-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 12px #10b981;
    animation: pulseGlow 1.8s infinite;
  }
  .avail-status {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
  }
  .avail-loc {
    display: block;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .response-time-pill {
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.1);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
    font-size: 0.8rem;
    font-weight: 600;
  }

  /* Grid Layout */
  .contact-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .col-heading {
    font-size: 1.35rem;
