---
// BaseLayout.astro
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import NeuralBackground from '../components/NeuralBackground.astro';
import AravindAI from '../components/AravindAI.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <SEO title={title} description={description} image={image} />
  </head>
  <body>
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <!-- Ambient glowing gradients -->
    <div class="ambient-glow glow-top-left" aria-hidden="true"></div>
    <div class="ambient-glow glow-middle-right" aria-hidden="true"></div>
    <div class="ambient-glow glow-bottom-left" aria-hidden="true"></div>

    <!-- Interactive Neural particle canvas -->
    <NeuralBackground />

    <!-- Application Wrapper -->
    <div class="app-layout">
      <slot name="header" />
      <main id="main-content">
        <slot />
      </main>
      <slot name="footer" />
    </div>

    <!-- Interactive Aravind AI Portfolio Assistant Widget -->
    <AravindAI />

    <!-- Global copy toast notification -->
    <div id="toast" class="toast-notice" role="alert" aria-live="polite">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span id="toast-text">Copied to clipboard!</span>
    </div>

    <script>
      // Global toast notification helper
      window.showToast = function (message = 'Copied to clipboard!') {
        const toast = document.getElementById('toast');
        const text = document.getElementById('toast-text');
        if (!toast || !text) return;

        text.textContent = message;
        toast.classList.add('show');

        setTimeout(() => {
          toast.classList.remove('show');
        }, 2800);
      };

      // Global copy trigger
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest('[data-copy]');
        if (!target) return;

        const copyText = target.getAttribute('data-copy');
        if (!copyText) return;

        navigator.clipboard.writeText(copyText).then(() => {
          const customMsg = target.getAttribute('data-copy-msg') || 'Copied to clipboard!';
          window.showToast(customMsg);
        }).catch((err) => {
          console.error('Failed to copy', err);
        });
      });
    </script>
  </body>
</html>

<style>
  .app-layout {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  
  main {
    flex: 1;
  }
</style>
