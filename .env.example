# Site Configuration
# Canonical domain for SEO, sitemaps, and Open Graph metadata
SITE_URL=https://aravindnaidu.dev

# ==============================================================================
# AI PORTFOLIO AGENT (Aravind AI) - Serverless LLM Configuration
# ==============================================================================
# The frontend never exposes these keys to the browser; /api/chat is a server-side endpoint.
# If no key is configured, the assistant automatically uses the built-in authoritative
# knowledge base fallback engine with 100% reliability and zero hallucinations.

# Option 1: OpenAI (Recommended: gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Groq (Ultra-fast LLM inference: llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key_here

# ==============================================================================
# CONTACT SECTION / FORM DELIVERY SERVICE
# ==============================================================================
# The contact form securely submits to /api/contact without exposing secrets in client code.
# Configure ONE of the following services for automated email delivery:

# Option A: Resend (Recommended on Vercel)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>
CONTACT_EMAIL=aravindyallao@gmail.com

# Option B: Web3Forms (Free, zero-setup access key)
# WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Option C: Formspree
# FORMSPREE_ID=your_formspree_form_id_here
